{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "octacore",
  "account_id": "5be08b854a3e045d8267e290ecee5ba6",
  "main": "worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "octacore"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "octacore-db",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      // Deployed sites, keyed by slug.
      "binding": "SITES"
    },
    {
      // Uploaded images, logos and PDFs, served at /u/<id>.
      "binding": "UPLOADS"
    }
  ],
  // <slug>.octacore.app serves deployed sites (needs a proxied `*` DNS record on the zone).
  "routes": [{ "pattern": "*.octacore.app/*", "zone_name": "octacore.app" }],
  "workers_dev": true,
  // OPENAI_API_KEY is a secret: set it in the dashboard (type Secret) or with `wrangler secret put`.
  "vars": {
    "OPENAI_MODEL": "gpt-6-sol",
    "OPENAI_CHAT_MODEL": "gpt-6-sol",
    "SITES_DOMAIN": "octacore.app",
    "OPENAI_BASE_URL": "https://api.openai.com/v1"
  },
  "observability": { "enabled": true }
}
